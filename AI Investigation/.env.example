# MuleGraph local environment (gitignored — never commit real keys)
# Loaded automatically by app/env.py at startup.
# Real environment variables always win over values in this file.

# ------------------------------------------------------------------ #
# AI providers (see /api/v1/ai/providers/status)
# ------------------------------------------------------------------ #
# PRIMARY: Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SECONDARY (optional): Hugging Face Inference Router — https://huggingface.co/settings/tokens
# NOTE: router.huggingface.co needs PRO/pay-as-you-go access for most models;
# a free token authenticates but may get 402/429 on completions.
HF_API_KEY=

# Provider overrides (defaults shown; uncomment to change)
# NOTE: gemini-2.5-flash is retired for new accounts; gemini-3.8-flash was
# returning sustained 503s (high demand) — lite variants respond in ~2s.
MULEGRAPH_AI_GEMINI_MODEL=gemini-3.5-flash-lite
# MULEGRAPH_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# MULEGRAPH_AI_HF_MODEL=Qwen/Qwen2.5-72B-Instruct
# MULEGRAPH_AI_HF_BASE_URL=https://router.huggingface.co/v1
# MULEGRAPH_AI_TIMEOUT_S=45
# MULEGRAPH_AI_MAX_RETRIES=1

# ------------------------------------------------------------------ #
# Bounded autonomy (investigation budget)
# ------------------------------------------------------------------ #
# MULEGRAPH_AI_MAX_TOOL_CALLS=25
# MULEGRAPH_AI_MAX_STEPS=8
# MULEGRAPH_AI_MAX_TOOLS_PER_STEP=3
# MULEGRAPH_AI_MAX_WALL_CLOCK_S=180
# MULEGRAPH_AI_MAX_TOKENS=4096
# MULEGRAPH_AI_TEMPERATURE=0.1

# ------------------------------------------------------------------ #
# Sessions / audit / defaults
# ------------------------------------------------------------------ #
# Where investigation state is persisted (unset = in-memory only)
# MULEGRAPH_AI_STATE_DIR=.ai_state
# JSONL audit trail (unset = no audit file)
# MULEGRAPH_AI_AUDIT_PATH=.ai_audit.jsonl
# MULEGRAPH_AI_DEFAULT_WINDOW=24h
# MULEGRAPH_AI_DEFAULT_PROFILE=FAST
# MULEGRAPH_AI_CACHE=1

# Point tools at a REMOTE graph engine instead of in-process (default: in-process)
# Required by the standalone AI service; point to the separately running engine.
MULEGRAPH_AI_GRAPH_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------ #
# Graph engine (app/config.py) — optional, defaults are fine
# ------------------------------------------------------------------ #
# Durable event log: replayed on startup, so the graph is populated.
# Relative paths resolve against the mulegraph project root (app/paths.py),
# e.g. data/paysim_events.jsonl -> <mulegraph>/data/paysim_events.jsonl
# MULEGRAPH_EVENT_FILE=data/paysim_events.jsonl
# Runtime mirror for live/demo ingest (POST /api/v1/graph/transaction).
# Separate from the dataset log above so demo/test traffic can never
# pollute the imported dataset. Defaults to MULEGRAPH_EVENT_FILE when unset.
# MULEGRAPH_MIRROR_FILE=data/graph_events.jsonl
# MULEGRAPH_DEFAULT_WINDOW=5m
# MULEGRAPH_DEFAULT_PROFILE=STANDARD
