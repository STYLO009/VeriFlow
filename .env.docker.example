REDIS_PORT=6379
GRAPH_ENGINE_PORT=8000
BACKEND_PORT=4000

# DATABASE_URL remains the existing external PostgreSQL/Neon connection.
# It is loaded from apps/Backend/.env by Docker Compose.

FRONTEND_URL=http://localhost:5173
GRAPH_ENGINE_TIMEOUT_MS=2000
JWT_SECRET=hackmatrix-local-development-jwt-secret-change-me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
OUTCOME_API_KEY=hackmatrix-local-outcome-key-change-me
REDIS_STREAM_NAME=transaction-outcomes
REDIS_DEAD_LETTER_STREAM=transaction-outcomes:dead-letter
REDIS_CONSUMER_GROUP=graph-workers
REDIS_CONSUMER_NAME=backend-docker
REDIS_MAX_ATTEMPTS=5
REDIS_RETRY_BASE_DELAY_MS=1000

# MuleGraph Redis consumer config
MULEGRAPH_REDIS_URL=redis://redis:6379/0
MULEGRAPH_REDIS_STREAM=transaction-outcomes
MULEGRAPH_REDIS_GROUP=graph-workers
MULEGRAPH_REDIS_CONSUMER=mulegraph-worker
MULEGRAPH_REDIS_MAX_ATTEMPTS=5
MULEGRAPH_REDIS_BACKOFF_MS=1000
