{
  "name": "...",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "infra:up": "docker compose up -d --build",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f --tail=100",
    "infra:status": "docker compose ps",
    "infra:migrate": "docker compose run --rm backend bunx prisma migrate deploy",
    "infra:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prettier": "3.9.6",
    "prisma": "^7.10.1",
    "turbo": "^2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  }
}
